      "type": "string"
    },
    "place_groups": {
      "items": {
        "type": "string"
      },
      "title": "Place Groups",
      "type": "array"
    },
    "units": {
      "items": {
        "$ref": "#/$defs/GoldUnit"
      },
      "minItems": 1,
      "title": "Units",
      "type": "array"
    },
    "notes": {
      "default": "",
      "title": "Notes",
      "type": "string"
    }
