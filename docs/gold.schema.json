          "type": "boolean"
        }
      },
      "required": [
        "span",
        "entity_type",
        "components"
      ],
      "title": "GoldUnit",
      "type": "object"
    }
  },
  "properties": {
    "id": {
      "title": "Id",
      "type": "string"
    },
    "text": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Text",
      "type": "string"
    },
    "input_kind": {
      "enum": [
        "place_name",
        "address"
