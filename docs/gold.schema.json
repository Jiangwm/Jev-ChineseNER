          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            }
          ],
          "title": "Span",
          "type": "array"
        },
        "role": {
          "enum": [
            "proper_name",
            "generic",
            "qualifier",
            "number",
            "unknown",
            "not_entity"
          ],
          "title": "Role",
          "type": "string"
        }
      },
      "required": [
        "span",
        "role"
      ],
      "title": "GoldComponent",
      "type": "object"
    },
    "GoldUnit": {
      "properties": {
        "span": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            }
          ],
          "title": "Span",
          "type": "array"
        },
        "entity_type": {
          "enum": [
            "province",
            "city",
            "district",
            "town",
            "village",
            "road",
            "bridge",
            "water",
            "mountain",
            "poi",
            "organization",
            "house_number",
            "separator",
            "unknown",
            "not_entity"
          ],
          "title": "Entity Type",
          "type": "string"
        },
        "components": {
          "items": {
            "$ref": "#/$defs/GoldComponent"
          },
          "minItems": 1,
          "title": "Components",
          "type": "array"
        },
        "oov": {
          "default": false,
