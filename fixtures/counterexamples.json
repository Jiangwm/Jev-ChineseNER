    "assertions": {
      "units": [
        "东南大学"
      ],
      "types": [
        "organization"
      ],
      "components": [
        [
          [
            "东南",
            "proper_name"
          ],
          [
            "大学",
            "generic"
          ]
        ]
      ],
      "forbidden_types": [
        "poi"
      ]
    }
  },
  {
    "text": "宁夏回族自治区",
